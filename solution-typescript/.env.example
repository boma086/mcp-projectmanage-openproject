# TypeScript MCP Solution Environment Configuration

# Application Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=8040
LOG_LEVEL=info

# OpenProject Configuration
OPENPROJECT_URL=https://your-openproject.com
OPENPROJECT_API_KEY=your-api-key-here

# CORS Configuration
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1

# Performance Configuration
REQUEST_TIMEOUT=30000
MAX_CONNECTIONS=100
CACHE_TTL=300

# Node.js Specific Configuration
NODE_OPTIONS=--max-old-space-size=512 --optimize-for-size --max-executable-size=96 --stack-size=8192
UV_THREADPOOL_SIZE=128

# Security Configuration
TRUST_PROXY=false

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PATH=/metrics
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
STRUCTURED_LOGGING=true
CORRELATION_IDS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Features
CORS_ENABLED=true
CORS_ORIGIN=*
HELMET_ENABLED=true
COMPRESSION_ENABLED=true

# Docker Compose Configuration
TYPESCRIPT_PORT=8040
OPENPROJECT_PORT=8090
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Database Configuration
POSTGRES_DB=openproject
POSTGRES_USER=openproject
POSTGRES_PASSWORD=openproject_password

# OpenProject Configuration
OPENPROJECT_HOST=localhost:8090
OPENPROJECT_SECRET_KEY_BASE=your-secret-key-here

# Email Configuration (Optional)
EMAIL_DELIVERY_METHOD=smtp
SMTP_ADDRESS=localhost
SMTP_PORT=587

# Monitoring Configuration
GRAFANA_PASSWORD=admin

# Registry Configuration (for production)
REGISTRY=docker.io
IMAGE_TAG=latest
