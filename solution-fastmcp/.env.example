# FastMCP Solution Environment Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8030
SSE_PORT=8031
DEBUG=False

# OpenProject Configuration
OPENPROJECT_URL=https://your-openproject.com
OPENPROJECT_API_KEY=your-api-key-here
OPENPROJECT_TIMEOUT=30
OPENPROJECT_MAX_RETRIES=3

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_ENDPOINT=/metrics
METRICS_PORT=9093
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
CORRELATION_IDS=true

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
DEEP_HEALTH_CHECK_INTERVAL=300

# MCP Configuration
MCP_PROTOCOL_VERSION=2024-11-05
MCP_SESSION_TIMEOUT=300
MAX_SESSIONS=1000
SESSION_TIMEOUT=3600

# SSE Configuration
SSE_ENABLED=true
SSE_PORT=8031

# Performance Configuration
MAX_CONCURRENT_REQUESTS=500
REQUEST_TIMEOUT=30
MAX_REQUEST_SIZE=10485760
MAX_CONNECTIONS=100

# Cache Configuration
CACHE_TTL=300
ENABLE_CACHE=true

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password-here
REDIS_PORT=6379

# Ports for external services
FASTMCP_PORT=8030
FASTMCP_SSE_PORT=8031
REDIS_PORT=6379
OPENPROJECT_PORT=8090
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Database Configuration (for OpenProject)
POSTGRES_DB=openproject
POSTGRES_USER=openproject
POSTGRES_PASSWORD=openproject_password

# Email Configuration (optional)
EMAIL_DELIVERY_METHOD=smtp
SMTP_ADDRESS=localhost
SMTP_PORT=587

# Security Configuration
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1
TRUSTED_HOSTS=localhost,127.0.0.1

# Monitoring Configuration
GRAFANA_PASSWORD=admin
ENABLE_ACCESS_LOG=true
LOG_JSON_FORMAT=false

# Docker Compose Profiles
COMPOSE_PROFILES=development,minimal,production,testing,monitoring

# Environment
ENVIRONMENT=development
