{
  "dashboard": {
    "id": null,
    "title": "MCP OpenProject - FastMCP Solution",
    "tags": ["mcp", "openproject", "fastmcp"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "FastMCP Service Health",
        "type": "stat",
        "targets": [
          {
            "expr": "health_check_status{check_type=\"service\", service=\"fastmcp-solution\"}",
            "legendFormat": "Service Health"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": {
                    "text": "Unhealthy"
                  },
                  "1": {
                    "text": "Healthy"
                  }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "color": {
              "mode": "thresholds"
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "SSE Connections",
        "type": "stat",
        "targets": [
          {
            "expr": "sse_connections_total{service=\"fastmcp-solution\"}",
            "legendFormat": "SSE Connections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "MCP Sessions",
        "type": "stat",
        "targets": [
          {
            "expr": "mcp_sessions_total{service=\"fastmcp-solution\"}",
            "legendFormat": "Active Sessions"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 0
        }
      },
      {
        "id": 4,
        "title": "MCP Protocol Operations",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(mcp_protocol_operations_total{service=\"fastmcp-solution\"}[5m])",
            "legendFormat": "{{operation}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops/s"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 5,
        "title": "SSE Message Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(sse_messages_total{service=\"fastmcp-solution\"}[5m])",
            "legendFormat": "{{message_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "msg/s"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 6,
        "title": "MCP Session Duration",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(mcp_session_duration_seconds_bucket{service=\"fastmcp-solution\"}[5m])) by (le))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(mcp_session_duration_seconds_bucket{service=\"fastmcp-solution\"}[5m])) by (le))",
            "legendFormat": "P95"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 16
        }
      },
      {
        "id": 7,
        "title": "HTTP Request Metrics",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(http_requests_total{service=\"fastmcp-solution\"}[5m])",
            "legendFormat": "Request Rate"
          },
          {
            "expr": "rate(http_errors_total{service=\"fastmcp-solution\"}[5m])",
            "legendFormat": "Error Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 24
        }
      },
      {
        "id": 8,
        "title": "MCP Operation Success Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(mcp_operations_total{status=\"success\", service=\"fastmcp-solution\"}[5m]) / rate(mcp_operations_total{service=\"fastmcp-solution\"}[5m])",
            "legendFormat": "Success Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 24
        }
      },
      {
        "id": 9,
        "title": "FastMCP Performance Summary",
        "type": "table",
        "targets": [
          {
            "expr": "rate(mcp_operations_total{service=\"fastmcp-solution\"}[5m])",
            "legendFormat": "Operations/s"
          },
          {
            "expr": "sse_connections_total{service=\"fastmcp-solution\"}",
            "legendFormat": "SSE Connections"
          },
          {
            "expr": "mcp_sessions_total{service=\"fastmcp-solution\"}",
            "legendFormat": "Active Sessions"
          },
          {
            "expr": "rate(sse_messages_total{service=\"fastmcp-solution\"}[5m])",
            "legendFormat": "Messages/s"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 32
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}