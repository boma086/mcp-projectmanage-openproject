{
  "dashboard": {
    "id": null,
    "title": "MCP OpenProject - TypeScript Solution",
    "tags": ["mcp", "openproject", "typescript"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "TypeScript Service Health",
        "type": "stat",
        "targets": [
          {
            "expr": "health_check_status{check_type=\"service\", service=\"typescript-solution\"}",
            "legendFormat": "Service Health"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": {
                    "text": "Unhealthy"
                  },
                  "1": {
                    "text": "Healthy"
                  }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "color": {
              "mode": "thresholds"
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Node.js Process Health",
        "type": "stat",
        "targets": [
          {
            "expr": "node_health_check_status{service=\"typescript-solution\"}",
            "legendFormat": "Process Health"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": {
                    "text": "Unhealthy"
                  },
                  "1": {
                    "text": "Healthy"
                  }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "color": {
              "mode": "thresholds"
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Event Loop Lag",
        "type": "stat",
        "targets": [
          {
            "expr": "nodejs_eventloop_lag_seconds{service=\"typescript-solution\"}",
            "legendFormat": "Event Loop Lag"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 0.1
                },
                {
                  "color": "red",
                  "value": 0.5
                }
              ]
            },
            "color": {
              "mode": "thresholds"
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 0
        }
      },
      {
        "id": 4,
        "title": "HTTP Request Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(http_requests_total{service=\"typescript-solution\"}[5m])",
            "legendFormat": "Requests"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 5,
        "title": "Memory Usage",
        "type": "timeseries",
        "targets": [
          {
            "expr": "nodejs_heap_size_bytes{service=\"typescript-solution\"} / 1024 / 1024",
            "legendFormat": "Heap Size"
          },
          {
            "expr": "nodejs_heap_used_bytes{service=\"typescript-solution\"} / 1024 / 1024",
            "legendFormat": "Heap Used"
          },
          {
            "expr": "nodejs_external_memory_bytes{service=\"typescript-solution\"} / 1024 / 1024",
            "legendFormat": "External Memory"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "MB"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 6,
        "title": "Response Time Percentiles",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service=\"typescript-solution\"}[5m])) by (le))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"typescript-solution\"}[5m])) by (le))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service=\"typescript-solution\"}[5m])) by (le))",
            "legendFormat": "P99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 16
        }
      },
      {
        "id": 7,
        "title": "MCP Operations by Status",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(mcp_operations_total{status=\"success\", service=\"typescript-solution\"}[5m])",
            "legendFormat": "Success"
          },
          {
            "expr": "rate(mcp_operations_total{status=\"error\", service=\"typescript-solution\"}[5m])",
            "legendFormat": "Error"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops/s"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 24
        }
      },
      {
        "id": 8,
        "title": "Garbage Collection",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(nodejs_gc_duration_seconds_sum{service=\"typescript-solution\"}[5m])",
            "legendFormat": "GC Time/s"
          },
          {
            "expr": "increase(nodejs_gc_runs_total{service=\"typescript-solution\"}[5m])",
            "legendFormat": "GC Runs"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 24
        }
      },
      {
        "id": 9,
        "title": "Node.js Performance Summary",
        "type": "table",
        "targets": [
          {
            "expr": "nodejs_heap_used_bytes{service=\"typescript-solution\"} / 1024 / 1024",
            "legendFormat": "Heap Used (MB)"
          },
          {
            "expr": "nodejs_eventloop_lag_seconds{service=\"typescript-solution\"}",
            "legendFormat": "Event Loop Lag (s)"
          },
          {
            "expr": "rate(nodejs_gc_duration_seconds_sum{service=\"typescript-solution\"}[5m])",
            "legendFormat": "GC Time/s"
          },
          {
            "expr": "process_cpu_seconds_total{service=\"typescript-solution\"}",
            "legendFormat": "CPU Time"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 32
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}