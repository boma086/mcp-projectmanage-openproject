# FastAPI MCP Server Environment Configuration Template
# Copy this file to .env and configure for your environment

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
APP_NAME=Async OpenProject MCP Server
APP_VERSION=1.0.0
ENVIRONMENT=production  # development, production, testing
DEBUG=false

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
HOST=0.0.0.0
PORT=8020
WORKERS=4
WORKER_CONNECTIONS=1000
MAX_CONCURRENT_REQUESTS=1000

# ============================================================================
# OPENPROJECT INTEGRATION
# ============================================================================
# Required: OpenProject server URL
OPENPROJECT_URL=https://your-openproject-instance.com

# Required: OpenProject API key (generate in OpenProject user settings)
OPENPROJECT_API_KEY=your_api_key_here

# Optional: OpenProject connection settings
OPENPROJECT_TIMEOUT=30
OPENPROJECT_MAX_RETRIES=3
OPENPROJECT_RETRY_DELAY=1.0

# ============================================================================
# PERFORMANCE CONFIGURATION
# ============================================================================
# Request handling
REQUEST_TIMEOUT=30
MAX_REQUEST_SIZE=10485760  # 10MB
SLOW_REQUEST_THRESHOLD=1.0

# HTTP client settings
HTTP_CLIENT_MAX_CONNECTIONS=100
HTTP_CLIENT_MAX_KEEPALIVE=50
HTTP_CLIENT_KEEPALIVE_EXPIRY=30

# WebSocket configuration
WEBSOCKET_ENABLED=true
MAX_WEBSOCKET_CONNECTIONS=1000
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MESSAGE_MAX_SIZE=1048576  # 1MB

# ============================================================================
# CACHING CONFIGURATION (Redis)
# ============================================================================
# Redis connection
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_CONNECTIONS=50
CACHE_TIMEOUT=5

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# CORS settings
ALLOWED_ORIGINS=*  # Use specific domains in production
TRUSTED_HOSTS=localhost,127.0.0.1

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# SSL/TLS (for production)
SSL_KEYFILE=
SSL_CERTFILE=
ENABLE_HTTPS_REDIRECT=false

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
ENABLE_ACCESS_LOG=true
LOG_JSON_FORMAT=false

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================
# Metrics
ENABLE_METRICS=true
METRICS_ENDPOINT=/metrics

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================================================
# DATABASE CONFIGURATION (Optional)
# ============================================================================
# Uncomment if using database features
# DATABASE_URL=postgresql://user:password@localhost:5432/database
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT=30

# ============================================================================
# TASK QUEUE CONFIGURATION (Optional)
# ============================================================================
# Uncomment if using Celery for background tasks
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
# TASK_QUEUE_ENABLED=false
# MAX_BACKGROUND_TASKS=50

# ============================================================================
# INTERNATIONALIZATION
# ============================================================================
DEFAULT_TEMPLATE_LANGUAGE=en
SUPPORTED_LANGUAGES=en,zh,ja

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================
# Override for development environment
# ENVIRONMENT=development
# DEBUG=true
# LOG_LEVEL=DEBUG
# WORKERS=1
# CACHE_ENABLED=false

# ============================================================================
# PRODUCTION OVERRIDES
# ============================================================================
# Example production settings (uncomment as needed)
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=INFO
# WORKERS=4
# ALLOWED_ORIGINS=https://your-domain.com
# TRUSTED_HOSTS=your-domain.com,localhost
# ENABLE_HTTPS_REDIRECT=true

# ============================================================================
# DOCKER BUILD CONFIGURATION
# ============================================================================
BUILD_DATE=
VCS_REF=

# ============================================================================
# MONITORING AND ALERTING
# ============================================================================
# Add monitoring service configurations here
# ALERTMANAGER_URL=
# SLACK_WEBHOOK_URL=
# EMAIL_NOTIFICATIONS=false