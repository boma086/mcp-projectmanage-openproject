# Testing Environment Configuration
# Used for automated testing and CI/CD pipelines

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=testing
DEBUG=false
TESTING=true

# =============================================================================
# OpenProject Configuration
# =============================================================================
OPENPROJECT_URL=http://openproject-mock:8080
OPENPROJECT_API_KEY=test-api-key

# =============================================================================
# Server Configuration
# =============================================================================
# HTTP Solution
HTTP_PORT=8010
HTTP_HOST=0.0.0.0
HTTP_WORKERS=1

# FastAPI Solution
FASTAPI_PORT=8020
FASTAPI_HOST=0.0.0.0
FASTAPI_WORKERS=1
FASTAPI_WORKER_CONNECTIONS=10
FASTAPI_MAX_CONCURRENT_REQUESTS=10

# FastMCP Solution
FASTMCP_PORT=8030
FASTMCP_HOST=0.0.0.0

# TypeScript Solution
TYPESCRIPT_PORT=8040
TYPESCRIPT_HOST=0.0.0.0

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mcpdb_test
POSTGRES_USER=mcpuser
POSTGRES_PASSWORD=testpass
DATABASE_URL=sqlite:///test.db  # Use SQLite for testing

# Database Pool Settings (minimal for testing)
DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=1
DATABASE_POOL_TIMEOUT=5
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1  # Use different DB for testing
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/1

# Redis Pool Settings (minimal for testing)
REDIS_MAX_CONNECTIONS=5
REDIS_TIMEOUT=5

# Cache Settings
CACHE_ENABLED=true
CACHE_DEFAULT_TIMEOUT=60  # Short timeout for testing
CACHE_TYPE=simple

# =============================================================================
# Security Configuration
# =============================================================================
SECRET_KEY=test-secret-key-for-testing-only
JWT_SECRET_KEY=test-jwt-secret-key-for-testing-only

# Authentication
ENABLE_AUTH=true
REQUIRE_HTTPS=false
TOKEN_EXPIRY=300  # 5 minutes for testing
REFRESH_TOKEN_EXPIRY=3600

# CORS Configuration (permissive for testing)
CORS_ENABLED=true
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# Rate Limiting (disabled for testing)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_REQUESTS_PER_HOUR=10000

# =============================================================================
# Performance Configuration
# =============================================================================
# Async Settings (minimal for testing)
ASYNC_POOL_SIZE=1
HTTP_CLIENT_MAX_CONNECTIONS=5
HTTP_CLIENT_MAX_KEEPALIVE=2
WEBSOCKET_MAX_CONNECTIONS=10

# Request Settings
REQUEST_TIMEOUT=10  # Short timeout for testing
MAX_REQUEST_SIZE=1MB

# Worker Settings
WORKER_TIMEOUT=10
WORKER_KEEPALIVE=1
WORKER_MAX_REQUESTS=10

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=WARNING
LOG_FORMAT=standard
LOG_FILE=

# Structured Logging
ENABLE_STRUCTURED_LOGGING=true
LOG_CORRELATION_ID=true

# =============================================================================
# Monitoring Configuration
# =============================================================================
# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=10
HEALTH_CHECK_TIMEOUT=5

# Metrics (disabled for testing)
ENABLE_METRICS=false
METRICS_PATH=/metrics
METRICS_PORT=9090

# Tracing (disabled for testing)
ENABLE_TRACING=false
TRACING_SERVICE_NAME=mcp-server-test
TRACING_SAMPLING_RATIO=1.0

# =============================================================================
# Testing Configuration
# =============================================================================
# Testing Settings
DEV_RELOAD=false
DEV_DEBUG_TOOLBAR=false
DEV_PROFILING=false

# Test Settings
TEST_DATABASE_URL=sqlite:///test.db
TEST_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# Test Data Configuration
# =============================================================================
# Test Data Generation
TEST_DATA_GENERATION_ENABLED=true
TEST_DATA_COUNT=10
TEST_DATA_CLEANUP_ENABLED=true
TEST_DATA_SEED_ENABLED=true

# Mock Services
MOCK_OPENPROJECT_ENABLED=true
MOCK_REDIS_ENABLED=true
MOCK_DATABASE_ENABLED=false

# =============================================================================
# Docker Testing Settings
# =============================================================================
DOCKER_REGISTRY=localhost:5000
DOCKER_IMAGE_TAG=test
DOCKER_PULL_POLICY=Always

# =============================================================================
# Kubernetes Testing Settings
# =============================================================================
K8S_NAMESPACE=mcp-openproject-test
K8S_REPLICAS=1
K8S_REVISION_HISTORY_LIMIT=1

# Autoscaling (disabled for testing)
HPA_ENABLED=false
HPA_MIN_REPLICAS=1
HPA_MAX_REPLICAS=1

# =============================================================================
# Feature Flags (all enabled for testing)
# =============================================================================
FEATURE_WEBSOCKETS=true
FEATURE_REPORTING=true
FEATURE_I18N=true
FEATURE_MONITORING=false  # Disabled for testing
FEATURE_CACHING=true
FEATURE_AUTH=true

# =============================================================================
# Test Configuration
# =============================================================================
# Test Runner
TEST_RUNNER=pytest
TEST_COVERAGE_ENABLED=true
TEST_COVERAGE_THRESHOLD=80

# Test Categories
TEST_UNIT_ENABLED=true
TEST_INTEGRATION_ENABLED=true
TEST_E2E_ENABLED=false  # Disabled for CI speed
TEST_PERFORMANCE_ENABLED=false

# Test Parallelization
TEST_PARALLEL_ENABLED=true
TEST_PARALLEL_WORKERS=4

# Test Timeout
TEST_TIMEOUT=30
TEST_RETRY_COUNT=3

# =============================================================================
# CI/CD Configuration
# =============================================================================
# CI Environment
CI=true
CI_BUILD_NUMBER=${CI_BUILD_NUMBER:-0}
CI_COMMIT_SHA=${CI_COMMIT_SHA:-unknown}
CI_BRANCH=${CI_BRANCH:-unknown}

# Artifact Storage
TEST_ARTIFACTS_ENABLED=true
TEST_ARTIFACTS_PATH=./test-results
TEST_ARTIFACTS_RETENTION_DAYS=7

# =============================================================================
# Test Reporting
# =============================================================================
# JUnit XML Reports
TEST_JUNIT_REPORTS_ENABLED=true
TEST_JUNIT_REPORTS_PATH=./test-results/junit

# HTML Reports
TEST_HTML_REPORTS_ENABLED=true
TEST_HTML_REPORTS_PATH=./test-results/html

# Coverage Reports
TEST_COVERAGE_REPORTS_ENABLED=true
TEST_COVERAGE_REPORTS_PATH=./test-results/coverage

# =============================================================================
# Test Data Cleanup
# =============================================================================
# Cleanup Strategy
TEST_CLEANUP_STRATEGY=after  # before, after, never
TEST_CLEANUP_FAILED_TESTS=true
TEST_CLEANUP_PASSED_TESTS=true

# Database Cleanup
TEST_DB_CLEANUP_ENABLED=true
TEST_DB_CLEANUP_METHOD=truncate  # truncate, drop, transaction

# Redis Cleanup
TEST_REDIS_CLEANUP_ENABLED=true
TEST_REDIS_CLEANUP_METHOD=flush  # flush, delete

# =============================================================================
# Test Monitoring
# =============================================================================
# Test Performance Monitoring
TEST_PERFORMANCE_MONITORING_ENABLED=false
TEST_PERFORMANCE_THRESHOLD_CPU=90
TEST_PERFORMANCE_THRESHOLD_MEMORY=90

# Test Memory Leak Detection
TEST_MEMORY_LEAK_DETECTION_ENABLED=true
TEST_MEMORY_LEAK_THRESHOLD=10  # MB

# =============================================================================
# Test Security
# =============================================================================
# Test Security Scanning
TEST_SECURITY_SCAN_ENABLED=true
TEST_DEPENDENCY_SCAN_ENABLED=true
TEST_VULNERABILITY_SCAN_ENABLED=true

# Test Secret Detection
TEST_SECRET_DETECTION_ENABLED=true
TEST_SECRET_DETECTION_PATTERNS=.env,.key,.secret,password,token

# =============================================================================
# External Services (Testing)
# =============================================================================
# Email (disabled for testing)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Slack (disabled for testing)
SLACK_WEBHOOK_URL=

# Sentry (disabled for testing)
SENTRY_DSN=

# Mock Services
MOCK_EMAIL_SERVICE=true
MOCK_NOTIFICATION_SERVICE=true
MOCK_STORAGE_SERVICE=true

# =============================================================================
# Test Utilities
# =============================================================================
# Test Fixtures
TEST_FIXTURES_ENABLED=true
TEST_FIXTURES_PATH=./tests/fixtures

# Test Factories
TEST_FACTORIES_ENABLED=true
TEST_FACTORIES_PATH=./tests/factories

# Test Mocks
TEST_MOCKS_ENABLED=true
TEST_MOCKS_PATH=./tests/mocks

# =============================================================================
# Test Environment Setup
# =============================================================================
# Database Setup
TEST_DB_SETUP_SCRIPT=./tests/setup-test-db.sh
TEST_DB_TEARDOWN_SCRIPT=./tests/teardown-test-db.sh

# Service Setup
TEST_SERVICE_SETUP_SCRIPT=./tests/setup-test-services.sh
TEST_SERVICE_TEARDOWN_SCRIPT=./tests/teardown-test-services.sh

# =============================================================================
# Test Performance
# =============================================================================
# Load Testing
LOAD_TEST_ENABLED=false
LOAD_TEST_CONCURRENT_USERS=10
LOAD_TEST_DURATION=60
LOAD_TEST_RAMP_UP=10

# Stress Testing
STRESS_TEST_ENABLED=false
STRESS_TEST_MAX_USERS=100
STRESS_TEST_DURATION=300

# =============================================================================
# Notes
# =============================================================================
# 1. This configuration is optimized for testing and CI/CD
# 2. All settings are tuned for fast test execution
# 3. Mock services are enabled to reduce external dependencies
# 4. Database connections are minimal to conserve resources
# 5. Monitoring and tracing are disabled to reduce overhead
# 6. Test data cleanup is enabled to maintain test isolation
# 7. Security scanning is enabled for CI/CD pipelines
# 8. This configuration should not be used in production
# 9. Test data should never contain real sensitive information
# 10. Regular test maintenance is recommended