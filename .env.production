# Production Environment Configuration
# Copy this file to .env.production and customize with real values

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=production
DEBUG=false
TESTING=false

# =============================================================================
# OpenProject Configuration
# =============================================================================
OPENPROJECT_URL=https://your-production-openproject.com
OPENPROJECT_API_KEY=your-production-api-key-here

# =============================================================================
# Server Configuration
# =============================================================================
# HTTP Solution
HTTP_PORT=8010
HTTP_HOST=0.0.0.0
HTTP_WORKERS=4

# FastAPI Solution
FASTAPI_PORT=8020
FASTAPI_HOST=0.0.0.0
FASTAPI_WORKERS=4
FASTAPI_WORKER_CONNECTIONS=1000
FASTAPI_MAX_CONCURRENT_REQUESTS=1000

# FastMCP Solution
FASTMCP_PORT=8030
FASTMCP_HOST=0.0.0.0

# TypeScript Solution
TYPESCRIPT_PORT=8040
TYPESCRIPT_HOST=0.0.0.0

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_HOST=postgres-service
POSTGRES_PORT=5432
POSTGRES_DB=mcpdb_prod
POSTGRES_USER=mcpuser
POSTGRES_PASSWORD=your-secure-postgres-password
DATABASE_URL=postgresql://mcpuser:your-secure-postgres-password@postgres-service:5432/mcpdb_prod

# Database Pool Settings (optimized for production)
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-secure-redis-password
REDIS_URL=redis://:your-secure-redis-password@redis-service:6379/0

# Redis Pool Settings (optimized for production)
REDIS_MAX_CONNECTIONS=50
REDIS_TIMEOUT=5

# Cache Settings
CACHE_ENABLED=true
CACHE_DEFAULT_TIMEOUT=300
CACHE_TYPE=redis

# =============================================================================
# Security Configuration
# =============================================================================
# Generate these with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-here-minimum-32-characters
JWT_SECRET_KEY=your-super-secret-jwt-key-here-minimum-32-characters

# Authentication
ENABLE_AUTH=true
REQUIRE_HTTPS=true
TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=86400

# CORS Configuration (restricted for production)
CORS_ENABLED=true
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# Rate Limiting (enabled for production)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# =============================================================================
# Performance Configuration
# =============================================================================
# Async Settings (optimized for production)
ASYNC_POOL_SIZE=20
HTTP_CLIENT_MAX_CONNECTIONS=100
HTTP_CLIENT_MAX_KEEPALIVE=50
WEBSOCKET_MAX_CONNECTIONS=1000

# Request Settings
REQUEST_TIMEOUT=30
MAX_REQUEST_SIZE=10MB

# Worker Settings
WORKER_TIMEOUT=30
WORKER_KEEPALIVE=2
WORKER_MAX_REQUESTS=1000

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/mcp-server/app.log

# Structured Logging
ENABLE_STRUCTURED_LOGGING=true
LOG_CORRELATION_ID=true

# =============================================================================
# Monitoring Configuration
# =============================================================================
# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Metrics (enabled for production)
ENABLE_METRICS=true
METRICS_PATH=/metrics
METRICS_PORT=9090

# Tracing (enabled for production)
ENABLE_TRACING=true
TRACING_SERVICE_NAME=mcp-server-prod
TRACING_SAMPLING_RATIO=0.1

# =============================================================================
# Production Configuration
# =============================================================================
# Production Settings
PROD_LOG_LEVEL=INFO
PROD_WORKERS=4
PROD_MAX_REQUESTS=1000

# Security
PROD_REQUIRE_HTTPS=true
PROD_ENABLE_CORS=true
PROD_ENABLE_RATE_LIMIT=true

# =============================================================================
# Docker Production Settings
# =============================================================================
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_TAG=latest
DOCKER_PULL_POLICY=Always

# =============================================================================
# Kubernetes Production Settings
# =============================================================================
K8S_NAMESPACE=mcp-openproject
K8S_REPLICAS=3
K8S_REVISION_HISTORY_LIMIT=10

# Autoscaling (enabled for production)
HPA_ENABLED=true
HPA_MIN_REPLICAS=2
HPA_MAX_REPLICAS=10
HPA_CPU_TARGET_UTILIZATION=70
HPA_MEMORY_TARGET_UTILIZATION=80

# =============================================================================
# Feature Flags (production-ready features)
# =============================================================================
FEATURE_WEBSOCKETS=true
FEATURE_REPORTING=true
FEATURE_I18N=true
FEATURE_MONITORING=true
FEATURE_CACHING=true
FEATURE_AUTH=true

# =============================================================================
# External Services (Production)
# =============================================================================
# Email (for notifications)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-email@your-domain.com
SMTP_PASSWORD=your-email-password
SMTP_USE_TLS=true

# Slack (for alerts and notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Sentry (for error tracking)
SENTRY_DSN=https://your-key@sentry.io/project-id

# =============================================================================
# Cloud Provider Configuration
# =============================================================================
# AWS (if using AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-backup-bucket

# Google Cloud (if using GCP)
GCP_PROJECT=your-gcp-project
GCP_REGION=us-central1
GCP_SERVICE_ACCOUNT_KEY=your-gcp-service-account-key

# Azure (if using Azure)
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# =============================================================================
# Backup Configuration
# =============================================================================
# Database Backup
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_S3_BUCKET=your-backup-bucket

# Redis Backup
REDIS_BACKUP_ENABLED=true
REDIS_BACKUP_SCHEDULE=0 3 * * *  # Daily at 3 AM
REDIS_BACKUP_RETENTION_DAYS=7

# =============================================================================
# SSL/TLS Configuration
# =============================================================================
SSL_CERT_PATH=/etc/ssl/certs/your-cert.pem
SSL_KEY_PATH=/etc/ssl/private/your-key.pem
SSL_CHAIN_PATH=/etc/ssl/certs/your-chain.pem

# =============================================================================
# Production Security Headers
# =============================================================================
SECURITY_HEADERS=true
CSP_ENABLED=true
CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss: https:; frame-ancestors 'none';"
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# =============================================================================
# Production Monitoring and Alerting
# =============================================================================
# Alertmanager Configuration
ALERTMANAGER_URL=http://alertmanager:9093
ALERT_SEVERITY_LEVEL=warning

# Uptime Monitoring
UPTIME_CHECK_ENABLED=true
UPTIME_CHECK_INTERVAL=60
UPTIME_CHECK_URL=https://your-domain.com/health

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_THRESHOLD_CPU=80
PERFORMANCE_THRESHOLD_MEMORY=85
PERFORMANCE_THRESHOLD_DISK=90

# =============================================================================
# Production Database Settings
# =============================================================================
# Connection Pool Monitoring
DB_POOL_MONITORING_ENABLED=true
DB_POOL_WARN_THRESHOLD=80
DB_POOL_CRITICAL_THRESHOLD=90

# Query Performance
DB_SLOW_QUERY_THRESHOLD=1000  # milliseconds
DB_QUERY_MONITORING_ENABLED=true

# =============================================================================
# Production Cache Settings
# =============================================================================
# Redis Monitoring
REDIS_MONITORING_ENABLED=true
REDIS_MEMORY_THRESHOLD=85
REDIS_CONNECTION_THRESHOLD=80

# Cache Invalidation
CACHE_INVALIDATION_ENABLED=true
CACHE_INVALIDATION_SCHEDULE=0 4 * * *  # Daily at 4 AM

# =============================================================================
# Production Logging and Auditing
# =============================================================================
# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=/var/log/mcp-server/audit.log
AUDIT_LOG_LEVEL=INFO

# Access Logging
ACCESS_LOG_ENABLED=true
ACCESS_LOG_FILE=/var/log/mcp-server/access.log

# Error Tracking
ERROR_TRACKING_ENABLED=true
ERROR_SAMPLING_RATE=1.0

# =============================================================================
# Production Backup and Disaster Recovery
# =============================================================================
# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 1 * * *  # Daily at 1 AM
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=true

# Disaster Recovery
DR_ENABLED=true
DR_RPO=3600  # Recovery Point Objective: 1 hour
DR_RTO=1800  # Recovery Time Objective: 30 minutes

# =============================================================================
# Production Maintenance
# =============================================================================
# Maintenance Mode
MAINTENANCE_MODE_ENABLED=false
MAINTENANCE_MODE_FILE=/tmp/maintenance.mode

# Health Check Endpoints
HEALTH_CHECK_DETAILED=true
HEALTH_CHECK_INCLUDE_DEPENDENCIES=true

# =============================================================================
# Production Compliance
# =============================================================================
# GDPR Compliance
GDPR_COMPLIANCE_ENABLED=true
DATA_RETENTION_DAYS=365
DATA_ANONYMIZATION_ENABLED=true

# Security Compliance
SECURITY_COMPLIANCE_ENABLED=true
VULNERABILITY_SCANNING_ENABLED=true
PENETRATION_TESTING_ENABLED=true

# =============================================================================
# Notes
# =============================================================================
# 1. This configuration is optimized for production deployment
# 2. Security is enabled and properly configured
# 3. Monitoring and tracing are enabled for observability
# 4. All passwords and keys must be changed to secure values
# 5. SSL/TLS certificates must be properly configured
# 6. Backup and disaster recovery are enabled
# 7. Compliance features are enabled
# 8. This configuration should be stored securely
# 9. Never commit this file with real secrets to version control
# 10. Regular security audits are recommended