# Development Environment Configuration
# Copy this file to .env.development and customize as needed

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development
DEBUG=true
TESTING=false

# =============================================================================
# OpenProject Configuration
# =============================================================================
OPENPROJECT_URL=https://your-openproject.com
OPENPROJECT_API_KEY=your-api-key-here

# =============================================================================
# Server Configuration
# =============================================================================
# HTTP Solution
HTTP_PORT=8010
HTTP_HOST=0.0.0.0
HTTP_WORKERS=1

# FastAPI Solution
FASTAPI_PORT=8020
FASTAPI_HOST=0.0.0.0
FASTAPI_WORKERS=1
FASTAPI_WORKER_CONNECTIONS=100
FASTAPI_MAX_CONCURRENT_REQUESTS=100

# FastMCP Solution
FASTMCP_PORT=8030
FASTMCP_HOST=0.0.0.0

# TypeScript Solution
TYPESCRIPT_PORT=8040
TYPESCRIPT_HOST=0.0.0.0

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mcpdb_dev
POSTGRES_USER=mcpuser
POSTGRES_PASSWORD=mcppass
DATABASE_URL=postgresql://mcpuser:mcppass@localhost:5432/mcpdb_dev

# Database Pool Settings (reduced for development)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Redis Pool Settings (reduced for development)
REDIS_MAX_CONNECTIONS=10
REDIS_TIMEOUT=5

# Cache Settings
CACHE_ENABLED=true
CACHE_DEFAULT_TIMEOUT=300
CACHE_TYPE=simple

# =============================================================================
# Security Configuration
# =============================================================================
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production

# Authentication
ENABLE_AUTH=true
REQUIRE_HTTPS=false
TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=86400

# CORS Configuration (permissive for development)
CORS_ENABLED=true
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# Rate Limiting (disabled for development)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_REQUESTS_PER_HOUR=10000

# =============================================================================
# Performance Configuration
# =============================================================================
# Async Settings (reduced for development)
ASYNC_POOL_SIZE=5
HTTP_CLIENT_MAX_CONNECTIONS=20
HTTP_CLIENT_MAX_KEEPALIVE=10
WEBSOCKET_MAX_CONNECTIONS=100

# Request Settings
REQUEST_TIMEOUT=30
MAX_REQUEST_SIZE=10MB

# Worker Settings
WORKER_TIMEOUT=30
WORKER_KEEPALIVE=2
WORKER_MAX_REQUESTS=100

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=DEBUG
LOG_FORMAT=standard
LOG_FILE=

# Structured Logging
ENABLE_STRUCTURED_LOGGING=true
LOG_CORRELATION_ID=true

# =============================================================================
# Monitoring Configuration
# =============================================================================
# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Metrics (disabled for development)
ENABLE_METRICS=false
METRICS_PATH=/metrics
METRICS_PORT=9090

# Tracing (disabled for development)
ENABLE_TRACING=false
TRACING_SERVICE_NAME=mcp-server-dev
TRACING_SAMPLING_RATIO=0.1

# =============================================================================
# Development Configuration
# =============================================================================
# Development Settings
DEV_RELOAD=true
DEV_DEBUG_TOOLBAR=false
DEV_PROFILING=false

# Testing Settings
TEST_DATABASE_URL=sqlite:///test.db
TEST_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# Feature Flags (all enabled for development)
# =============================================================================
FEATURE_WEBSOCKETS=true
FEATURE_REPORTING=true
FEATURE_I18N=true
FEATURE_MONITORING=true
FEATURE_CACHING=true
FEATURE_AUTH=true

# =============================================================================
# Docker Development Settings
# =============================================================================
DOCKER_REGISTRY=localhost:5000
DOCKER_IMAGE_TAG=dev
DOCKER_PULL_POLICY=Always

# =============================================================================
# Kubernetes Development Settings
# =============================================================================
K8S_NAMESPACE=mcp-openproject-dev
K8S_REPLICAS=1
K8S_REVISION_HISTORY_LIMIT=3

# Autoscaling (disabled for development)
HPA_ENABLED=false
HPA_MIN_REPLICAS=1
HPA_MAX_REPLICAS=3

# =============================================================================
# Development Tools
# =============================================================================
# Database Tools
ENABLE_DB_MIGRATIONS=true
ENABLE_DB_SEEDING=true
DB_SEED_DATA_COUNT=10

# Debug Tools
ENABLE_PROFILER=false
ENABLE_DEBUG_ENDPOINTS=true
ENABLE_SWAGGER_DOCS=true

# Hot Reload
ENABLE_HOT_RELOAD=true
WATCH_FILE_CHANGES=true

# =============================================================================
# External Services (Development)
# =============================================================================
# Email (disabled for development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Slack (disabled for development)
SLACK_WEBHOOK_URL=

# Sentry (disabled for development)
SENTRY_DSN=

# =============================================================================
# Development-specific Scripts
# =============================================================================
# Development database setup
DEV_DB_SETUP_SCRIPT="./scripts/setup-dev-db.sh"

# Development server start command
DEV_START_COMMAND="./scripts/start-dev.sh"

# Development test command
DEV_TEST_COMMAND="./scripts/run-dev-tests.sh"

# =============================================================================
# Notes
# =============================================================================
# 1. This configuration is optimized for development
# 2. Security is relaxed for easier development
# 3. Monitoring and tracing are disabled to reduce overhead
# 4. Hot reload is enabled for faster development cycles
# 5. Database connections are limited to conserve resources
# 6. CORS is permissive to allow cross-origin requests
# 7. Rate limiting is disabled to avoid blocking development
# 8. Use this configuration for local development only
# 9. Never use this configuration in production
# 10. Keep sensitive keys secure even in development